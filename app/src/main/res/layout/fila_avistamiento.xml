<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="14dp" android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card" android:clickable="true" android:focusable="true">
    <TextView android:id="@+id/tvMonstruoFila" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/acento"
        android:textSize="17sp" android:textStyle="bold" />
    <TextView android:id="@+id/tvLugarFila" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textColor="@color/texto_principal" android:textSize="14sp" />
    <TextView android:id="@+id/tvFechaFila" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="3dp"
        android:textColor="@color/texto_secundario" android:textSize="12sp" />
    <ImageView android:id="@+id/ivFotoFila" android:layout_width="match_parent"
        android:layout_height="150dp" android:layout_marginTop="10dp"
        android:scaleType="centerCrop" android:visibility="gone"
        android:contentDescription="Fotografía del avistamiento" />
</LinearLayout>
