<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BESTIARIO"
                android:textColor="@color/acento"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.18" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="El mundo oculto\nte espera."
                android:textColor="@color/texto_principal"
                android:textSize="32sp"
                android:textStyle="bold"
                android:lineSpacingExtra="1dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="18dp"
                android:text="Explora leyendas, crea criaturas y registra tus encuentros."
                android:textColor="@color/texto_secundario"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/etBuscarMonstruo"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_search"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="12dp"
                android:hint="Buscar por nombre o descripción"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/texto_principal"
                android:textColorHint="@color/texto_secundario"
                android:singleLine="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnTodos"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="Todos"
                    android:textSize="12sp"
                    android:minWidth="0dp"
                    android:padding="2dp" />

                <Button
                    android:id="@+id/btnOriginales"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:text="Leyendas"
                    android:textSize="12sp"
                    android:minWidth="0dp"
                    android:padding="2dp" />

                <Button
                    android:id="@+id/btnCreados"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:text="Mis criaturas"
                    android:textSize="12sp"
                    android:minWidth="0dp"
                    android:padding="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Catálogo"
                    android:textColor="@color/texto_principal"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvContadorCatalogo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 criaturas"
                    android:textColor="@color/texto_secundario"
                    android:textSize="13sp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerMonstruos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <Button
                android:id="@+id/btnAleatorio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Sorpréndeme · criatura aleatoria" />

            <Button
                android:id="@+id/btnCrearMonstruo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="+ Crear mi criatura" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/superficie"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/botonFavoritos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Favoritos"
            android:textSize="11sp"
            android:minWidth="0dp"
            android:padding="2dp" />

        <Button
            android:id="@+id/btnDiario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Diario"
            android:textSize="11sp"
            android:minWidth="0dp"
            android:padding="2dp" />

        <Button
            android:id="@+id/btnEstadisticas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Estadísticas"
            android:textSize="11sp"
            android:minWidth="0dp"
            android:padding="2dp" />
    </LinearLayout>
</LinearLayout>
