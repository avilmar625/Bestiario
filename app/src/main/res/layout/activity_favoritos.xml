<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="18dp" android:background="@color/fondo">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="COLECCIÓN PERSONAL" android:textColor="@color/acento"
        android:textStyle="bold" android:textSize="12sp" android:letterSpacing="0.12" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:layout_marginBottom="14dp"
        android:text="Tus criaturas favoritas." android:textColor="@color/texto_principal"
        android:textSize="27sp" android:textStyle="bold" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerFavoritos"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <Button android:id="@+id/botonVolverFavoritos" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Volver" />
</LinearLayout>
