<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/fondo" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="BIBLIOTECA GLOBAL" android:textColor="@color/acento"
        android:textStyle="bold" android:letterSpacing="0.14" android:textSize="12sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="Explora más allá."
        android:textColor="@color/texto_principal" android:textSize="29sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:layout_marginBottom="16dp"
        android:text="Busca criaturas, mitos y leyendas en Wikipedia."
        android:textColor="@color/texto_secundario" />
    <EditText android:id="@+id/etConsultaOnline" android:layout_width="match_parent"
        android:layout_height="52dp" android:background="@drawable/bg_search"
        android:hint="Ej. dragones, mitología nórdica…" android:singleLine="true"
        android:imeOptions="actionSearch" android:inputType="text"
        android:paddingStart="14dp" android:paddingEnd="14dp"
        android:textColor="@color/texto_principal" android:textColorHint="@color/texto_secundario" />
    <Button android:id="@+id/btnBuscarOnline" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="Buscar en la biblioteca" />
    <ProgressBar android:id="@+id/progressOnline" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp" android:visibility="gone" />
    <TextView android:id="@+id/tvEstadoOnline" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:textColor="@color/texto_secundario" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerOnline"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginTop="8dp" />
    <Button android:id="@+id/btnCerrarOnline" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Volver" />
</LinearLayout>
