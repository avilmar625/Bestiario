<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="13dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/imagenFila"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginEnd="14dp"
        android:scaleType="centerCrop"
        android:contentDescription="Imagen del monstruo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tipoFila"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LEYENDA ORIGINAL"
            android:textColor="@color/acento"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/nombreFila"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/texto_principal"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/descripcionFila"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="@color/texto_secundario"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
